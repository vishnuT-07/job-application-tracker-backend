# ================================================================
# Sample configuration for Job Application Tracker Backend (PostgreSQL & Render)
# Copy this file to application.properties or set environment variables
# ================================================================

spring.application.name=job-application-tracker-backend

# Render dynamically assigns PORT, fallback to 8080 locally
server.port=${PORT:8080}

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_tracker_db

# Credentials (replace with your PostgreSQL credentials or Render Database URL)
# Locally:
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:job_tracker_db}}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:your_password_here}
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
